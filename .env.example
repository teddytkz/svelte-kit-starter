# MySQL connection — individual vars (no full URL).
# Bun auto-loads .env, so these are picked up by both the SvelteKit server
# and the `db/migrate.ts` / `db/seed.ts` runner scripts.

DB_URL="localhost"
DB_PORT="3306"
DB_USER="root"
DB_PASS="password"
DB_NAME="sveltes"

# JWT signing secret. MUST be at least 32 random bytes in production.
# Generate with:  openssl rand -base64 32
# The server throws on startup if this is missing or shorter than 32 chars.
JWT_SECRET="change-me-in-production-min-32-chars"
